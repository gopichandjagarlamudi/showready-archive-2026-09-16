{
  "name": "@showready/agent-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:go": "expo start",
    "ios": "node ./scripts/ios-local.cjs run",
    "ios:doctor": "node ./scripts/ios-local.cjs doctor",
    "android": "node ./scripts/android-local.cjs run",
    "android:avds": "node ./scripts/android-local.cjs avds",
    "android:devices": "node ./scripts/android-local.cjs devices",
    "android:doctor": "node ./scripts/android-local.cjs doctor",
    "android:emulator": "node ./scripts/android-local.cjs emulator",
    "build:android:development": "pnpm dlx eas-cli build --platform android --profile development",
    "build:android:preview": "pnpm dlx eas-cli build --platform android --profile preview",
    "build:android:production": "pnpm dlx eas-cli build --platform android --profile production",
    "seed:maestro": "node ./scripts/seed-maestro-state.cjs",
    "maestro:auth-url": "node ./scripts/create-maestro-auth-url.cjs",
    "test": "jest --runInBand --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:maestro:ios": "node ./scripts/run-maestro-ios.cjs .maestro/e2e-suite.yaml",
    "test:maestro:ios:smoke": "node ./scripts/run-maestro-ios.cjs .maestro/smoke-ios.yaml",
    "test:maestro:android": "node ./scripts/run-maestro-android.cjs .maestro/smoke-android.yaml",
    "test:maestro:android:e2e": "node ./scripts/run-maestro-android.cjs .maestro/e2e-android-release.yaml"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@showready/contracts": "workspace:*",
    "@showready/design-system": "workspace:*",
    "@showready/infrastructure": "workspace:*",
    "@supabase/supabase-js": "^2.84.0",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "^7.0.11",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.8",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.17",
    "babel-preset-expo": "54.0.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.13",
    "react-test-renderer": "19.1.0"
  }
}
