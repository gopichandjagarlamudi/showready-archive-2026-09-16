{
  "name": "showready-native-rebuild",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "corepack pnpm -r --workspace-concurrency=4 build",
    "dev": "corepack pnpm -r --parallel dev",
    "test": "corepack pnpm -r --workspace-concurrency=4 test",
    "typecheck": "corepack pnpm -r --workspace-concurrency=4 typecheck",
    "lint": "corepack pnpm -r --workspace-concurrency=4 lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.6.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
