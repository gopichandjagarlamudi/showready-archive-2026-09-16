NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LEAD_NOTIFICATION_WEBHOOK_URL=

# Required for guarded background job routes. Vercel Cron sends
# Authorization: Bearer $CRON_SECRET when this env var is configured.
CRON_SECRET=
# Optional alternate secret for manual or external outbox/retention invocations.
JOB_PROCESSOR_TOKEN=

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Leave this on localhost for local dev. The Expo Go app rewrites localhost to the
# current LAN host automatically when it is running on a real device.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

MAESTRO_DEMO_EMAIL=
MAESTRO_DEMO_PASSWORD=

# Use "supabase" in deployed multi-instance environments after applying
# apps/intake-web/lib/supabase/sql/2026-04-29-api-rate-limits.sql.
RATE_LIMIT_STORE=memory
